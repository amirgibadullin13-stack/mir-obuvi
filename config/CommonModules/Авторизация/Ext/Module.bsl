// ГДЕ: Общие модули -> Авторизация
// Флажки: Сервер = Да, Вызов сервера = Да, Клиент (управляемое приложение) = Нет, Глобальный = Нет

// Вход только по логину (пароль не требуется).
// Возвращает ссылку на пользователя или Неопределено, если логин не найден.
Функция Войти(Знач Логин) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Логин = &Логин
	|	И НЕ Пользователи.ПометкаУдаления";
	Запрос.УстановитьПараметр("Логин", СокрЛП(Логин));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыСеанса.ТекущийПользователь = Выборка.Ссылка;
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Выход / вход гостем (неавторизованный пользователь)
Процедура Выйти() Экспорт
	ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.ПустаяСсылка();
КонецПроцедуры

// Возвращает: "Гость", "Администратор", "Менеджер" или "Пользователь" (авторизованный)
Функция ТекущаяРоль() Экспорт
	
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Если Пользователь.Пустая() Тогда
		Возврат "Гость";
	КонецЕсли;
	Роль = Пользователь.Роль;
	Если Роль = Перечисления.Роли.Администратор Тогда
		Возврат "Администратор";
	ИначеЕсли Роль = Перечисления.Роли.Менеджер Тогда
		Возврат "Менеджер";
	КонецЕсли;
	Возврат "Пользователь";
	
КонецФункции
