// ГДЕ: Общие формы -> Главная -> Модуль формы
// Реквизиты формы: Логин (Строка 50), ВходВыполнен (Булево), ТекстПриветствия (Строка 150)
// Команды: Войти, ПродолжитьКакГость, ОткрытьКаталог, ОткрытьЗаказы, ОткрытьПоступления, Выйти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВходВыполнен = Не ПараметрыСеанса.ТекущийПользователь.Пустая();
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейс()
	
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Роль = Авторизация.ТекущаяРоль();
	
	Если Пользователь.Пустая() Тогда
		ТекстПриветствия = "Вы вошли как гость. Доступен просмотр каталога.";
	Иначе
		ТекстПриветствия = "Вы вошли как: " + Строка(Пользователь) + " (" + Строка(Пользователь.Роль) + ")";
	КонецЕсли;
	
	Элементы.ГруппаВход.Видимость = Не ВходВыполнен;
	Элементы.ГруппаМеню.Видимость = ВходВыполнен;
	Элементы.ОткрытьЗаказы.Видимость = (Роль = "Администратор" Или Роль = "Менеджер");
	Элементы.ОткрытьПоступления.Видимость = (Роль = "Администратор");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВойтиНаСервере(Логин)
	Возврат Авторизация.Войти(Логин) <> Неопределено;
КонецФункции

&НаСервереБезКонтекста
Процедура ВыйтиНаСервере()
	Авторизация.Выйти();
КонецПроцедуры

&НаКлиенте
Процедура Войти(Команда)
	
	Если ПустаяСтрока(Логин) Тогда
		ПоказатьПредупреждение(, "Введите логин.");
		Возврат;
	КонецЕсли;
	Если Не ВойтиНаСервере(Логин) Тогда
		ПоказатьПредупреждение(, "Пользователь с логином «" + Логин + "» не найден.");
		Возврат;
	КонецЕсли;
	ВходВыполнен = Истина;
	ОбновитьИнтерфейс();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьКакГость(Команда)
	ВыйтиНаСервере();
	ВходВыполнен = Истина;
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаКлиенте
Процедура Выйти(Команда)
	ВыйтиНаСервере();
	ВходВыполнен = Ложь;
	Логин = "";
	ОбновитьИнтерфейс();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталог(Команда)
	ОткрытьФорму("ОбщаяФорма.Каталог");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаказы(Команда)
	ОткрытьФорму("Документ.ЗаказТовара.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоступления(Команда)
	ОткрытьФорму("Документ.ПоступлениеТоваров.ФормаСписка");
КонецПроцедуры
