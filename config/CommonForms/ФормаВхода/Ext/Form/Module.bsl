&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Если пользователь уже авторизован, блокируем форму
	Если Не ПараметрыСеанса.ТекущийПользователь.Пустая() Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ПользовательУжеАвторизован() Тогда
		ОткрытьФорму("ОбщаяФорма.Каталог");
		ЭтаФорма.Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользовательУжеАвторизован()
	Возврат Не ПараметрыСеанса.ТекущийПользователь.Пустая();
КонецФункции

&НаКлиенте
Процедура Войти(Команда)
	ПоказатьПредупреждение(, "Нажата кнопка Войти! Проверяю...");
	
	Если ПустаяСтрока(Логин) Тогда
		ПоказатьПредупреждение(, "Введите логин.");
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ВойтиНаСервере(Логин) Тогда
			ОткрытьФорму("ОбщаяФорма.Каталог");
			ЭтаФорма.Закрыть();
		Иначе
			ПоказатьПредупреждение(, "Пользователь с логином «" + Логин + "» не найден.");
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, "Ошибка при входе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВойтиНаСервере(Знач Логин)
	Возврат Авторизация.Войти(Логин) <> Неопределено;
КонецФункции

&НаКлиенте
Процедура Гость(Команда)
	ПоказатьПредупреждение(, "Нажата кнопка Гость! Открываю каталог...");
	
	ВыйтиНаСервере();
	ОткрытьФорму("ОбщаяФорма.Каталог");
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыйтиНаСервере()
	Авторизация.Выйти();
КонецПроцедуры

&НаКлиенте
Процедура ВходВСистему(Команда)
	ПоказатьПредупреждение(, "Кнопка нажата! Проверяю логин...");
	
	Если ПустаяСтрока(Логин) Тогда
		ПоказатьПредупреждение(, "Вы не ввели логин!");
		Возврат;
	КонецЕсли;
	
	// Делаем запрос к базе (вдруг пользователи не загрузились)
	Если ВойтиНаСервере(Логин) Тогда
		ОткрытьФорму("ОбщаяФорма.Каталог");
		ЭтаФорма.Закрыть();
	Иначе
		ПоказатьПредупреждение(, "Пользователь с логином «" + Логин + "» НЕ НАЙДЕН в базе. Вы точно загрузили данные?");
	КонецЕсли;
КонецПроцедуры
