Перем КаталогДанных;
Перем КаталогКартинок;
Перем Ошибки;
Перем ТабРазмеры;
Перем ТабПользователи;
Перем ТабТовары;
Перем ТабОстатки;
Перем ТабЗаказы;

Процедура Загрузить(Знач ПутьДанных, Знач ОчиститьПередЗагрузкой = Ложь) Экспорт
	
	КаталогДанных = УбратьРазделитель(ПутьДанных);
	КаталогКартинок = КаталогДанных + "\Изображения";
	ФайлПроверка = Новый Файл(КаталогКартинок);
	Если Не ФайлПроверка.Существует() Тогда
		КаталогКартинок = КаталогДанных; 
	КонецЕсли;
	
	Ошибки = Новый Массив;
	
	НайтиИПрочитатьФайлы();
	
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Загрузка отменена. Ошибки:" + Символы.ПС + ТекстОшибок();
	КонецЕсли;
	
	Если Не ОчиститьПередЗагрузкой И Справочники.Товары.Выбрать().Следующий() Тогда
		ВызватьИсключение "В базе уже есть данные. Включите галочку «Очистить данные перед загрузкой».";
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если ОчиститьПередЗагрузкой Тогда
			ОчиститьДанные();
		КонецЕсли;
		ЗаписатьРазмеры();
		ЗаписатьПользователей();
		ЗаписатьТовары();
		СоздатьПоступление();
		СоздатьЗаказы();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиИПрочитатьФайлы()
	Файлы = НайтиФайлы(КаталогДанных, "*.xlsx");
	ФайлыДок = Новый Структура("Размеры, Пользователи, Товары, Остатки, Заказы");
	
	Для Каждого Файл Из Файлы Цикл
		Если Лев(Файл.Имя, 2) = "~$" Тогда
			Продолжить;
		КонецЕсли;
		
		Документ = Новый ТабличныйДокумент;
		Попытка
			Документ.Прочитать(Файл.ПолноеИмя, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		Исключение
			Ошибки.Добавить("Не удалось прочитать файл: " + Файл.Имя + ". Возможно, он открыт в Excel.");
			Продолжить;
		КонецПопытки;
		
		Строка1 = "";
		Для Кол = 1 По Документ.ШиринаТаблицы Цикл
			Попытка
				Текст = Документ.Область(1, Кол).Текст;
			Исключение
				Текст = "";
			КонецПопытки;
			Строка1 = Строка1 + " " + Нормализовать(Текст);
		КонецЦикла;
		
		Если Найти(Строка1, "НОМЕР ЗАКАЗА") > 0 Тогда 
			ФайлыДок.Заказы = Документ;
		ИначеЕсли Найти(Строка1, "ЛОГИН") > 0 Тогда 
			ФайлыДок.Пользователи = Документ;
		ИначеЕсли Найти(Строка1, "ДОСТУПНОЕ ДЛЯ ЗАКАЗА") > 0 Тогда 
			ФайлыДок.Остатки = Документ;
		ИначеЕсли Найти(Строка1, "ПОДКАТЕГОРИЯ") > 0 Тогда 
			ФайлыДок.Товары = Документ;
		ИначеЕсли Найти(Строка1, "РАЗМЕР") > 0 И Документ.ШиринаТаблицы = 1 Тогда 
			ФайлыДок.Размеры = Документ;
		КонецЕсли;
	КонецЦикла;
	
	Если ФайлыДок.Размеры = Неопределено Тогда Ошибки.Добавить("Не найден файл с размерами."); Иначе ТабРазмеры = ПрочитатьРазмеры(ФайлыДок.Размеры); КонецЕсли;
	Если ФайлыДок.Пользователи = Неопределено Тогда Ошибки.Добавить("Не найден файл с пользователями."); Иначе ТабПользователи = ПрочитатьПользователей(ФайлыДок.Пользователи, "Users"); КонецЕсли;
	Если ФайлыДок.Товары = Неопределено Тогда Ошибки.Добавить("Не найден файл с товарами."); Иначе ТабТовары = ПрочитатьТовары(ФайлыДок.Товары, "Products"); КонецЕсли;
	Если ФайлыДок.Остатки = Неопределено Тогда Ошибки.Добавить("Не найден файл с остатками."); Иначе ТабОстатки = ПрочитатьОстатки(ФайлыДок.Остатки, "Stock"); КонецЕсли;
	Если ФайлыДок.Заказы = Неопределено Тогда Ошибки.Добавить("Не найден файл с заказами."); Иначе ТабЗаказы = ПрочитатьЗаказы(ФайлыДок.Заказы, "Orders"); КонецЕсли;
КонецПроцедуры

Функция ПрочитатьРазмеры(Документ)
	ТабРазмеры = НоваяТаблица("Имя, Значение, Ссылка");
	Для Номер = 2 По Документ.ВысотаТаблицы Цикл
		Исходное = ЗначениеЯчейки(Документ, Номер, 1);
		Если Исходное = Неопределено Или Исходное = "" Тогда Продолжить; КонецЕсли;
		ИмяРазм = ИмяРазмера(Исходное);
		ЧислоРазм = ВЧисло(СтрЗаменить(ИмяРазм, ",", "."), КонтекстЯчейки("Размеры", Номер, "размер"));
		Если ЧислоРазм = Неопределено Или ТабРазмеры.Найти(ИмяРазм, "Имя") <> Неопределено Тогда Продолжить; КонецЕсли;
		Стр = ТабРазмеры.Добавить();
		Стр.Имя = ИмяРазм;
		Стр.Значение = ЧислоРазм;
	КонецЦикла;
	Возврат ТабРазмеры;
КонецФункции

Функция ПрочитатьПользователей(Документ, ИмяФайла)
	ТабПользователи = НоваяТаблица("Логин, Фамилия, Имя, Отчество, Роль, ФИО, ФИОНорм, Ссылка");
	ОшибокДо = Ошибки.Количество();
	
	кЛогин = НомерКолонки(Документ, ИмяФайла, "Логин");
	кФамилия = НомерКолонки(Документ, ИмяФайла, "Фамилия");
	кИмя = НомерКолонки(Документ, ИмяФайла, "Имя");
	кОтчество = НомерКолонки(Документ, ИмяФайла, "Отчество|Отчетсво");
	кРоль = НомерКолонки(Документ, ИмяФайла, "Роль");
	Если Ошибки.Количество() > ОшибокДо Тогда Возврат ТабПользователи; КонецЕсли;
	
	Для Номер = 2 По Документ.ВысотаТаблицы Цикл
		Логин = ТекстЯчейки(Документ, Номер, кЛогин);
		Если ПустаяСтрока(Логин) Тогда Продолжить; КонецЕсли;
		РольТекст = Нормализовать(ТекстЯчейки(Документ, Номер, кРоль));
		Если РольТекст <> "АДМИНИСТРАТОР" И РольТекст <> "МЕНЕДЖЕР" И РольТекст <> "АВТОРИЗОВАННЫЙ ПОЛЬЗОВАТЕЛЬ" Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Роль") + ": недопустимая роль.");
			Продолжить;
		КонецЕсли;
		Если ТабПользователи.Найти(Логин, "Логин") <> Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Логин") + ": дубль.");
			Продолжить;
		КонецЕсли;
		
		Стр = ТабПользователи.Добавить();
		Стр.Логин = Логин;
		Стр.Фамилия = ТекстЯчейки(Документ, Номер, кФамилия);
		Стр.Имя = ТекстЯчейки(Документ, Номер, кИмя);
		Стр.Отчество = ТекстЯчейки(Документ, Номер, кОтчество);
		Стр.Роль = РольТекст;
		Стр.ФИО = СокрЛП(Стр.Фамилия + " " + Стр.Имя + " " + Стр.Отчество);
		Стр.ФИОНорм = Нормализовать(Стр.ФИО);
	КонецЦикла;
	Возврат ТабПользователи;
КонецФункции

Функция ПрочитатьТовары(Документ, ИмяФайла)
	ТабТовары = НоваяТаблица("Ключ, НаимНорм, ПроизвНорм, Категория, Подкатегория, Файл, Наименование, Производство, Описание, Состав, Цена, Ссылка");
	ОшибокДо = Ошибки.Количество();
	
	кКатегория = НомерКолонки(Документ, ИмяФайла, "Категория");
	кПодкатегория = НомерКолонки(Документ, ИмяФайла, "Подкатегория");
	кФайл = НомерКолонки(Документ, ИмяФайла, "Изображение");
	кНаим = НомерКолонки(Документ, ИмяФайла, "Наименование товара");
	кПроизв = НомерКолонки(Документ, ИмяФайла, "Производство");
	кОписание = НомерКолонки(Документ, ИмяФайла, "Описание");
	кСостав = НомерКолонки(Документ, ИмяФайла, "Состав");
	кЦена = НомерКолонки(Документ, ИмяФайла, "Цена");
	Если Ошибки.Количество() > ОшибокДо Тогда Возврат ТабТовары; КонецЕсли;
	
	Для Номер = 2 По Документ.ВысотаТаблицы Цикл
		Наим = ТекстЯчейки(Документ, Номер, кНаим);
		Если ПустаяСтрока(Наим) Тогда Продолжить; КонецЕсли;
		Произв = ТекстЯчейки(Документ, Номер, кПроизв);
		Цена = ВЧисло(ЗначениеЯчейки(Документ, Номер, кЦена), КонтекстЯчейки(ИмяФайла, Номер, "Цена"));
		Ключ = Нормализовать(Наим) + "|" + Нормализовать(Произв);
		Если ТабТовары.Найти(Ключ, "Ключ") <> Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Наименование товара") + ": дубль.");
			Продолжить;
		КонецЕсли;
		Если Цена = Неопределено Тогда Продолжить; КонецЕсли;
		
		Стр = ТабТовары.Добавить();
		Стр.Ключ = Ключ;
		Стр.НаимНорм = Нормализовать(Наим);
		Стр.ПроизвНорм = Нормализовать(Произв);
		Стр.Категория = ТекстЯчейки(Документ, Номер, кКатегория);
		Стр.Подкатегория = ТекстЯчейки(Документ, Номер, кПодкатегория);
		Стр.Файл = ТекстЯчейки(Документ, Номер, кФайл);
		Стр.Наименование = Наим;
		Стр.Производство = Произв;
		Стр.Описание = ТекстЯчейки(Документ, Номер, кОписание);
		Стр.Состав = ТекстЯчейки(Документ, Номер, кСостав);
		Стр.Цена = Цена;
	КонецЦикла;
	Возврат ТабТовары;
КонецФункции

Функция ПрочитатьОстатки(Документ, ИмяФайла)
	ТабОстатки = НоваяТаблица("КлючТовара, Размер, Количество");
	ОшибокДо = Ошибки.Количество();
	
	кНаим = НомерКолонки(Документ, ИмяФайла, "Наименование товара");
	кПроизв = НомерКолонки(Документ, ИмяФайла, "Производство");
	кРазмер = НомерКолонки(Документ, ИмяФайла, "Размер");
	кКол = НомерКолонки(Документ, ИмяФайла, "Количество доступное для заказа|Количество");
	Если Ошибки.Количество() > ОшибокДо Тогда Возврат ТабОстатки; КонецЕсли;
	
	Для Номер = 2 По Документ.ВысотаТаблицы Цикл
		Наим = ТекстЯчейки(Документ, Номер, кНаим);
		Если ПустаяСтрока(Наим) Тогда Продолжить; КонецЕсли;
		КлючТовара = НайтиКлючТовара(Наим, ТекстЯчейки(Документ, Номер, кПроизв));
		Если КлючТовара = Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Наименование товара") + ": товар не найден.");
			Продолжить;
		КонецЕсли;
		ИмяРазм = ИмяРазмера(ЗначениеЯчейки(Документ, Номер, кРазмер));
		Если ТабРазмеры.Найти(ИмяРазм, "Имя") = Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Размер") + ": размера нет.");
			Продолжить;
		КонецЕсли;
		Количество = ВЦелое(ЗначениеЯчейки(Документ, Номер, кКол), КонтекстЯчейки(ИмяФайла, Номер, "Количество"));
		Если Количество = Неопределено Тогда Продолжить; КонецЕсли;
		
		Стр = ТабОстатки.Добавить();
		Стр.КлючТовара = КлючТовара;
		Стр.Размер = ИмяРазм;
		Стр.Количество = Количество;
	КонецЦикла;
	Возврат ТабОстатки;
КонецФункции

Функция ПрочитатьЗаказы(Документ, ИмяФайла)
	ТабЗаказы = НоваяТаблица("Номер, Дата, ФИОНорм, КлючТовара, Размер, Количество, Цена");
	ОшибокДо = Ошибки.Количество();
	
	кНомер = НомерКолонки(Документ, ИмяФайла, "Номер заказа");
	кДата = НомерКолонки(Документ, ИмяФайла, "Дата заказа");
	кФИО = НомерКолонки(Документ, ИмяФайла, "ФИО");
	кНаим = НомерКолонки(Документ, ИмяФайла, "Наименование товара");
	кПроизв = НомерКолонки(Документ, ИмяФайла, "Производство");
	кРазмер = НомерКолонки(Документ, ИмяФайла, "Размер");
	кКол = НомерКолонки(Документ, ИмяФайла, "Количество");
	кЦена = НомерКолонки(Документ, ИмяФайла, "Цена за единицу|Цена");
	Если Ошибки.Количество() > ОшибокДо Тогда Возврат ТабЗаказы; КонецЕсли;
	
	Для Номер = 2 По Документ.ВысотаТаблицы Цикл
		НомерЗаказа = ВЦелое(ЗначениеЯчейки(Документ, Номер, кНомер), КонтекстЯчейки(ИмяФайла, Номер, "Номер заказа"));
		Если НомерЗаказа = Неопределено Тогда Продолжить; КонецЕсли;
		ДатаЗаказа = ВДату(ЗначениеЯчейки(Документ, Номер, кДата), КонтекстЯчейки(ИмяФайла, Номер, "Дата заказа"));
		
		ФИОНорм = Нормализовать(ТекстЯчейки(Документ, Номер, кФИО));
		Если ТабПользователи.Найти(ФИОНорм, "ФИОНорм") = Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "ФИО") + ": клиента нет в базе.");
		КонецЕсли;
		
		Наим = ТекстЯчейки(Документ, Номер, кНаим);
		КлючТовара = НайтиКлючТовара(Наим, ТекстЯчейки(Документ, Номер, кПроизв));
		Если КлючТовара = Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Наименование товара") + ": товар не найден.");
		КонецЕсли;
		
		ИмяРазм = ИмяРазмера(ЗначениеЯчейки(Документ, Номер, кРазмер));
		Если ТабРазмеры.Найти(ИмяРазм, "Имя") = Неопределено Тогда
			Ошибки.Добавить(КонтекстЯчейки(ИмяФайла, Номер, "Размер") + ": размера нет.");
		КонецЕсли;
		
		Количество = ВЦелое(ЗначениеЯчейки(Документ, Номер, кКол), КонтекстЯчейки(ИмяФайла, Номер, "Количество"));
		Цена = ВЧисло(ЗначениеЯчейки(Документ, Номер, кЦена), КонтекстЯчейки(ИмяФайла, Номер, "Цена за единицу"));
		
		Если ДатаЗаказа = Неопределено Или КлючТовара = Неопределено Или Количество = Неопределено Или Цена = Неопределено Тогда Продолжить; КонецЕсли;
		
		Стр = ТабЗаказы.Добавить();
		Стр.Номер = НомерЗаказа;
		Стр.Дата = ДатаЗаказа;
		Стр.ФИОНорм = ФИОНорм;
		Стр.КлючТовара = КлючТовара;
		Стр.Размер = ИмяРазм;
		Стр.Количество = Количество;
		Стр.Цена = Цена;
	КонецЦикла;
	Возврат ТабЗаказы;
КонецФункции

Процедура ОчиститьДанные()
	УдалитьДокументы(Документы.ЗаказТовара);
	УдалитьДокументы(Документы.ПоступлениеТоваров);
	УдалитьЭлементы(Справочники.Товары);
	УдалитьЭлементы(Справочники.Пользователи);
	УдалитьЭлементы(Справочники.Размеры);
	Авторизация.Выйти();
КонецПроцедуры

Процедура УдалитьДокументы(Менеджер)
	Выборка = Менеджер.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ПолучитьОбъект();
		Если ДокОбъект.Проведен Тогда ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
		ДокОбъект.Удалить();
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьЭлементы(Менеджер)
	Выборка = Менеджер.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлОбъект = Выборка.ПолучитьОбъект();
		ЭлОбъект.ОбменДанными.Загрузка = Истина;
		ЭлОбъект.Удалить();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРазмеры()
	Для Каждого Стр Из ТабРазмеры Цикл
		Элемент = Справочники.Размеры.СоздатьЭлемент();
		Элемент.Наименование = Стр.Имя;
		Элемент.Значение = Стр.Значение;
		Элемент.Записать();
		Стр.Ссылка = Элемент.Ссылка;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьПользователей()
	Для Каждого Стр Из ТабПользователи Цикл
		Элемент = Справочники.Пользователи.СоздатьЭлемент();
		Элемент.Логин = Стр.Логин;
		Элемент.Фамилия = Стр.Фамилия;
		Элемент.Имя = Стр.Имя;
		Элемент.Отчество = Стр.Отчество;
		Если Стр.Роль = "АДМИНИСТРАТОР" Тогда Элемент.Роль = Перечисления.Роли.Администратор;
		ИначеЕсли Стр.Роль = "МЕНЕДЖЕР" Тогда Элемент.Роль = Перечисления.Роли.Менеджер;
		Иначе Элемент.Роль = Перечисления.Роли.АвторизованныйПользователь; КонецЕсли;
		Элемент.Записать();
		Стр.Ссылка = Элемент.Ссылка;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьТовары()
	Для Каждого Стр Из ТабТовары Цикл
		Элемент = Справочники.Товары.СоздатьЭлемент();
		Элемент.Категория = Стр.Категория;
		Элемент.Подкатегория = Стр.Подкатегория;
		Элемент.Наименование = Стр.Наименование;
		Элемент.Производство = Стр.Производство;
		Элемент.Описание = Стр.Описание;
		Элемент.Состав = Стр.Состав;
		Элемент.Цена = Стр.Цена;
		
		ИмяФайла = ?(ПустаяСтрока(Стр.Файл), "picture.png", Стр.Файл);
		Путь = КаталогКартинок + "\" + ИмяФайла;
		Если Не ФайлСуществует(Путь) Тогда Путь = КаталогКартинок + "\picture.png"; КонецЕсли;
		Если ФайлСуществует(Путь) Тогда Элемент.Изображение = Новый ХранилищеЗначения(Новый ДвоичныеДанные(Путь)); КонецЕсли;
		
		Элемент.Записать();
		Стр.Ссылка = Элемент.Ссылка;
	КонецЦикла;
КонецПроцедуры

Процедура СоздатьПоступление()
	Если ТабОстатки.Количество() = 0 Тогда Возврат; КонецЕсли;
	Док = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Для Каждого Стр Из ТабОстатки Цикл
		Н = Док.Товары.Добавить();
		Н.Товар = ТабТовары.Найти(Стр.КлючТовара, "Ключ").Ссылка;
		Н.Размер = ТабРазмеры.Найти(Стр.Размер, "Имя").Ссылка;
		Н.Количество = Стр.Количество;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура СоздатьЗаказы()
	Если ТабЗаказы.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	// Собираем уникальные номера заказов без метода Выгрузить
	НомераЗаказов = Новый Массив;
	Для Каждого Стр Из ТабЗаказы Цикл
		Если НомераЗаказов.Найти(Стр.Номер) = Неопределено Тогда
			НомераЗаказов.Добавить(Стр.Номер);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекНомер Из НомераЗаказов Цикл
		Строки = ТабЗаказы.НайтиСтроки(Новый Структура("Номер", ТекНомер));
		Первая = Строки[0];
		Док = Документы.ЗаказТовара.СоздатьДокумент();
		Док.Номер = Первая.Номер;
		Док.Дата = Первая.Дата;
		Док.Клиент = ТабПользователи.Найти(Первая.ФИОНорм, "ФИОНорм").Ссылка;
		Для Каждого Стр Из Строки Цикл
			Н = Док.Товары.Добавить();
			Н.Товар = ТабТовары.Найти(Стр.КлючТовара, "Ключ").Ссылка;
			Н.Размер = ТабРазмеры.Найти(Стр.Размер, "Имя").Ссылка;
			Н.Количество = Стр.Количество;
			Н.Цена = Стр.Цена;
			Н.Сумма = Стр.Количество * Стр.Цена;
		КонецЦикла;
		Док.ДополнительныеСвойства.Вставить("ПропуститьДвижения", Истина);
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Функция ФайлСуществует(Путь)
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();
КонецФункции

Функция НоваяТаблица(Колонки)
	Таб = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(Колонки, ",") Цикл
		Таб.Колонки.Добавить(СокрЛП(ИмяКолонки));
	КонецЦикла;
	Возврат Таб;
КонецФункции

Функция НомерКолонки(Документ, ИмяФайла, Варианты)
	ВариантыМассив = СтрРазделить(Варианты, "|");
	Для Колонка = 1 По Документ.ШиринаТаблицы Цикл
		Заголовок = Нормализовать(ТекстЯчейки(Документ, 1, Колонка));
		Для Каждого Вариант Из ВариантыМассив Цикл
			Если Заголовок = Нормализовать(Вариант) Тогда Возврат Колонка; КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Ошибки.Добавить("Файл " + ИмяФайла + ": не найден столбец «" + ВариантыМассив[0] + "».");
	Возврат 0;
КонецФункции

Функция ЗначениеЯчейки(Документ, НомерСтроки, НомерКолонки)
	Если НомерКолонки = 0 Тогда Возврат Неопределено; КонецЕсли;
	Значение = Неопределено;
	Попытка
		Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
		Попытка
			Значение = Область.Значение;
		Исключение
			Значение = Область.Текст;
		КонецПопытки;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда Значение = Очистить(Значение); КонецЕсли;
	Если Значение = Неопределено Или Значение = "" Тогда 
		Попытка Значение = Очистить(Область.Текст); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ТекстЯчейки(Документ, НомерСтроки, НомерКолонки)
	Значение = ЗначениеЯчейки(Документ, НомерСтроки, НомерКолонки);
	Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
	Возврат Очистить(Строка(Значение));
КонецФункции

Функция КонтекстЯчейки(ИмяФайла, НомерСтроки, Столбец)
	Возврат "Файл " + ИмяФайла + ", строка " + Формат(НомерСтроки, "ЧГ=0") + ", столбец «" + Столбец + "»";
КонецФункции

Функция Очистить(Знач Значение)
	Значение = СтрЗаменить(Значение, Символ(160), " ");
	Пока Найти(Значение, "  ") > 0 Цикл Значение = СтрЗаменить(Значение, "  ", " "); КонецЦикла;
	Возврат СокрЛП(Значение);
КонецФункции

Функция Нормализовать(Знач Значение)
	Возврат ВРег(Очистить(Строка(Значение)));
КонецФункции

Функция ВЧисло(Значение, Контекст)
	Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Значение; КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Текст = СтрЗаменить(СтрЗаменить(Значение, " ", ""), ",", ".");
		Попытка Возврат Число(Текст); Исключение КонецПопытки;
	КонецЕсли;
	Ошибки.Добавить(Контекст + ": ожидалось число.");
	Возврат Неопределено;
КонецФункции

Функция ВЦелое(Значение, Контекст)
	Результат = ВЧисло(Значение, Контекст);
	Если Результат = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если Результат < 0 Или Результат <> Цел(Результат) Тогда
		Ошибки.Добавить(Контекст + ": ожидалось целое неотрицательное число.");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ВДату(Значение, Контекст)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда Возврат Значение; КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Дата(1899, 12, 30) + Цел(Значение) * 86400; КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = Лев(Значение, 10);
		
		// Формат DD.MM.YYYY
		Части = СтрРазделить(Текст, ".");
		Если Части.Количество() = 3 Тогда
			Попытка Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0])); Исключение КонецПопытки;
		КонецЕсли;
		
		// Формат YYYY-MM-DD (как в Excel)
		Части = СтрРазделить(Текст, "-");
		Если Части.Количество() = 3 Тогда
			Попытка Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2])); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Ошибки.Добавить(Контекст + ": ожидалась дата.");
	Возврат Неопределено;
КонецФункции

Функция ИмяРазмера(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Формат(Значение, "ЧРД=,; ЧГ=0"); КонецЕсли;
	Возврат СтрЗаменить(Очистить(Строка(Значение)), ".", ",");
КонецФункции

Функция НайтиКлючТовара(Наименование, Производство)
	НаимНорм = Нормализовать(Наименование);
	ПроизвНорм = Нормализовать(Производство);
	Ключ = НаимНорм + "|" + ПроизвНорм;
	Если ТабТовары.Найти(Ключ, "Ключ") <> Неопределено Тогда Возврат Ключ; КонецЕсли;
	Найденный = Неопределено;
	Для Каждого Стр Из ТабТовары Цикл
		Если Стр.ПроизвНорм = ПроизвНорм И Лев(Стр.НаимНорм, СтрДлина(НаимНорм)) = НаимНорм Тогда
			Если Найденный <> Неопределено Тогда Возврат Неопределено; КонецЕсли;
			Найденный = Стр.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Найденный;
КонецФункции

Функция УбратьРазделитель(Знач Путь)
	Путь = СокрЛП(Путь);
	Пока Прав(Путь, 1) = "\" Или Прав(Путь, 1) = "/" Цикл Путь = Лев(Путь, СтрДлина(Путь) - 1); КонецЦикла;
	Возврат Путь;
КонецФункции

Функция ТекстОшибок()
	Текст = "";
	Для Индекс = 0 По Мин(Ошибки.ВГраница(), 29) Цикл Текст = Текст + Ошибки[Индекс] + Символы.ПС; КонецЦикла;
	Если Ошибки.Количество() > 30 Тогда Текст = Текст + "... и ещё " + Формат(Ошибки.Количество() - 30, "ЧГ=0") + " ошибок."; КонецЕсли;
	Возврат Текст;
КонецФункции