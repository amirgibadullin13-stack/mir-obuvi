// ГДЕ: Документы -> ЗаказТовара -> Формы -> ФормаСписка -> Модуль формы
// На форме добавить команду "УдалитьЗаказ" (кнопка "Удалить заказ" в командной панели).
// В списке оставить колонки: Дата, Номер, Клиент, СуммаДокумента (ключевое: дата и ФИО клиента).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Роль = Авторизация.ТекущаяРоль();
	Если Роль <> "Администратор" И Роль <> "Менеджер" Тогда
		Сообщить("Недостаточно прав для просмотра заказов.");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаказ(Команда)
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите заказ.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("УдалитьЗаказЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Удалить выбранный заказ? Товары вернутся в доступное количество.",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаказЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьЗаказНаСервере(Элементы.Список.ТекущаяСтрока);
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЗаказНаСервере(Заказ)
	
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Если ЗаказОбъект.Проведен Тогда
		ЗаказОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	ЗаказОбъект.Удалить();
	
КонецПроцедуры
