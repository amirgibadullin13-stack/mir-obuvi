// ГДЕ: Документы -> ЗаказТовара -> Модуль объекта.
// ЗАМЕНИТЕ в модуле только эту функцию ПолучитьЧек (всё остальное в модуле оставьте).
// Объединение ячеек убрано: именно оно размножало текст по ячейкам. Строки пишутся в первую колонку
// и естественно переходят на соседние пустые ячейки.

Функция ПолучитьЧек() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	// Ширина колонок
	ТабДок.Область(1, 1, 1, 1).ШиринаКолонки = 42;
	ТабДок.Область(1, 2, 1, 2).ШиринаКолонки = 9;
	ТабДок.Область(1, 3, 1, 3).ШиринаКолонки = 9;
	ТабДок.Область(1, 4, 1, 4).ШиринаКолонки = 14;
	ТабДок.Область(1, 5, 1, 5).ШиринаКолонки = 14;
	
	// Шапка
	ТабДок.Область(1, 1).Текст = "Мир обуви";
	ТабДок.Область(2, 1).Текст = "Чек по заказу № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Область(3, 1).Текст = "Клиент: " + Клиент;
	
	// Заголовки таблицы
	Стр = 5;
	ТабДок.Область(Стр, 1).Текст = "Товар";
	ТабДок.Область(Стр, 2).Текст = "Размер";
	ТабДок.Область(Стр, 3).Текст = "Кол-во";
	ТабДок.Область(Стр, 4).Текст = "Цена, руб.";
	ТабДок.Область(Стр, 5).Текст = "Сумма, руб.";
	
	// Товары
	Для Каждого СтрТовары Из Товары Цикл
		Стр = Стр + 1;
		ТабДок.Область(Стр, 1).Текст = Строка(СтрТовары.Товар);
		ТабДок.Область(Стр, 2).Текст = Строка(СтрТовары.Размер);
		ТабДок.Область(Стр, 3).Текст = Формат(СтрТовары.Количество, "ЧГ=0");
		ТабДок.Область(Стр, 4).Текст = Формат(СтрТовары.Цена, "ЧДЦ=2; ЧГ=");
		ТабДок.Область(Стр, 5).Текст = Формат(СтрТовары.Сумма, "ЧДЦ=2; ЧГ=");
	КонецЦикла;
	
	// Итог
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "ИТОГО К ОПЛАТЕ: " + Формат(СуммаДокумента, "ЧДЦ=2; ЧГ=") + " руб.";
	
	Возврат ТабДок;
	
КонецФункции
