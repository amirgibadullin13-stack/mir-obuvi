&НаСервере
Функция ЭкранироватьОбразец(Знач Текст)
	
	Текст = СтрЗаменить(Текст, "\", "\\");
	Текст = СтрЗаменить(Текст, "%", "\%");
	Текст = СтрЗаменить(Текст, "_", "\_");
	Текст = СтрЗаменить(Текст, "[", "\[");
	Текст = СтрЗаменить(Текст, "]", "\]");
	Возврат Текст;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьТовары()
	
	Запрос = Новый Запрос;
	Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.Категория КАК Категория,
	|	Т.Подкатегория КАК Подкатегория,
	|	Т.Производство КАК Производство,
	|	Т.Цена КАК Цена,
	|	ЕСТЬNULL(О.Количество, 0) КАК Остаток
	|ИЗ
	|	Справочник.Товары КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Ост.Товар КАК Товар,
	|			СУММА(Ост.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ОстаткиТоваров.Остатки КАК Ост
	|		СГРУППИРОВАТЬ ПО
	|			Ост.Товар) КАК О
	|		ПО О.Товар = Т.Ссылка
	|ГДЕ
	|	НЕ Т.ПометкаУдаления";
	
	Категория = ЭтотОбъект["ФильтрКатегория"];
	Если ЗначениеЗаполнено(Категория) Тогда
		Текст = Текст + "
		|	И Т.Категория = &Категория";
		Запрос.УстановитьПараметр("Категория", Категория);
	КонецЕсли;
	
	Производство = ЭтотОбъект["ФильтрПроизводство"];
	Если ЗначениеЗаполнено(Производство) Тогда
		Текст = Текст + "
		|	И Т.Производство = &Производство";
		Запрос.УстановитьПараметр("Производство", Производство);
	КонецЕсли;
	
	ТекстПоиска = СокрЛП(ЭтотОбъект["Поиск"]);
	Если ТекстПоиска <> "" Тогда
		Запрос.УстановитьПараметр("Образец", "%" + ЭкранироватьОбразец(ТекстПоиска) + "%");
		Текст = Текст + "
		|	И (Т.Наименование ПОДОБНО &Образец СПЕЦСИМВОЛ ""\""
		|		ИЛИ Т.Категория ПОДОБНО &Образец СПЕЦСИМВОЛ ""\""
		|		ИЛИ Т.Подкатегория ПОДОБНО &Образец СПЕЦСИМВОЛ ""\""
		|		ИЛИ Т.Производство ПОДОБНО &Образец СПЕЦСИМВОЛ ""\"")";
	КонецЕсли;
	
	Сортировка = ЭтотОбъект["Сортировка"];
	Если Сортировка = "ЦенаВозр" Тогда
		Текст = Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	Цена,
		|	Наименование";
	ИначеЕсли Сортировка = "ЦенаУбыв" Тогда
		Текст = Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	Цена УБЫВ,
		|	Наименование";
	Иначе
		Текст = Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	КонецЕсли;
	
	Запрос.Текст = Текст;
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "Товары");
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)
	ЗагрузитьТовары();
КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда)
	
	ЭтотОбъект["Поиск"] = "";
	ЭтотОбъект["ФильтрКатегория"] = "";
	ЭтотОбъект["ФильтрПроизводство"] = "";
	ЭтотОбъект["Сортировка"] = "Наименование";
	ЗагрузитьТовары();
	
КонецПроцедуры

// ---------------------------------------------------------------------------------------------
// КАРТОЧКА ВЫБРАННОЙ МОДЕЛИ
// ---------------------------------------------------------------------------------------------

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	ПодключитьОбработчикОжидания("ОбновитьКарточку", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКарточку()
	
	ТекущиеДанные = Элементы.ТаблицаТовары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбновитьКарточкуНаСервере(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточкуНаСервере(Товар)
	
	ЭтотОбъект["НазваниеТовара"] = Товар.Наименование;
	ЭтотОбъект["ЦенаТовара"] = Формат(Товар.Цена, "ЧДЦ=2; ЧГ=") + " руб.";
	ЭтотОбъект["ОписаниеТовара"] = Товар.Описание;
	ЭтотОбъект["СоставТовара"] = Товар.Состав;
	
	Данные = Товар.Изображение.Получить();
	Если Данные <> Неопределено Тогда
		ЭтотОбъект["АдресИзображения"] = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	Иначе
		ЭтотОбъект["АдресИзображения"] = "";
	КонецЕсли;
	
	Если Авторизация.ТекущаяРоль() = "Гость" Тогда
		Возврат;
	КонецЕсли;
	
	// Доступные для заказа размеры выбранной модели
	СписокРазмеров = Элементы.ПолеРазмер.СписокВыбора;
	СписокРазмеров.Очистить();
	ЭтотОбъект["ВыбранныйРазмер"] = Справочники.Размеры.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Размер КАК Размер,
	|	Ост.Размер.Значение КАК Порядок,
	|	Ост.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК Ост
	|ГДЕ
	|	Ост.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокРазмеров.Добавить(Выборка.Размер,
			Строка(Выборка.Размер) + " (в наличии: " + Формат(Выборка.Количество, "ЧГ=0") + " шт.)");
		Если Не ЗначениеЗаполнено(ЭтотОбъект["ВыбранныйРазмер"]) Тогда
			ЭтотОбъект["ВыбранныйРазмер"] = Выборка.Размер;   // первый доступный размер выбирается сразу
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// ---------------------------------------------------------------------------------------------
// КОРЗИНА
// ---------------------------------------------------------------------------------------------

&НаСервереБезКонтекста
Функция ДоступноеКоличество(Товар, Размер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Ост.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар И Размер = &Размер) КАК Ост";
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Размер", Размер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВКорзину(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаТовары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите модель в списке.");
		Возврат;
	КонецЕсли;
	
	Размер = ЭтотОбъект["ВыбранныйРазмер"];
	Если Не ЗначениеЗаполнено(Размер) Тогда
		ПоказатьПредупреждение(, "Для этой модели нет размеров в наличии или размер не выбран.");
		Возврат;
	КонецЕсли;
	
	Количество = ЭтотОбъект["ВыбранноеКоличество"];
	Если Количество <= 0 Тогда
		Количество = 1;
	КонецЕсли;
	
	Товар = ТекущиеДанные.Ссылка;
	Доступно = ДоступноеКоличество(Товар, Размер);
	ТабКорзина = ЭтотОбъект["Корзина"];
	
	СтрокаКорзины = Неопределено;
	Для Каждого Стр Из ТабКорзина Цикл
		Если Стр.Товар = Товар И Стр.Размер = Размер Тогда
			СтрокаКорзины = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	УжеВКорзине = ?(СтрокаКорзины = Неопределено, 0, СтрокаКорзины.Количество);
	Если Количество + УжеВКорзине > Доступно Тогда
		ПоказатьПредупреждение(, "Недостаточно товара. Доступно: " + Формат(Доступно, "ЧГ=0")
			+ " шт., уже в корзине: " + Формат(УжеВКорзине, "ЧГ=0") + " шт.");
		Возврат;
	КонецЕсли;
	
	Если СтрокаКорзины = Неопределено Тогда
		СтрокаКорзины = ТабКорзина.Добавить();
		СтрокаКорзины.Товар = Товар;
		СтрокаКорзины.Название = ТекущиеДанные.Наименование;
		СтрокаКорзины.Размер = Размер;
		СтрокаКорзины.Цена = ТекущиеДанные.Цена;
		СтрокаКорзины.Количество = 0;
	КонецЕсли;
	СтрокаКорзины.Количество = СтрокаКорзины.Количество + Количество;
	
	ПересчитатьКорзину();
	ПоказатьОповещениеПользователя("Добавлено в корзину", , ТекущиеДанные.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьКорзину()
	
	Итого = 0;
	Для Каждого Стр Из ЭтотОбъект["Корзина"] Цикл
		Стр.Сумма = Стр.Количество * Стр.Цена;
		Итого = Итого + Стр.Сумма;
	КонецЦикла;
	ЭтотОбъект["ИтогоКорзина"] = Итого;
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаКорзина.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество <= 0 Тогда
		ЭтотОбъект["Корзина"].Удалить(ТекущиеДанные);
	Иначе
		Доступно = ДоступноеКоличество(ТекущиеДанные.Товар, ТекущиеДанные.Размер);
		Если ТекущиеДанные.Количество > Доступно Тогда
			ПоказатьПредупреждение(, "Доступно только " + Формат(Доступно, "ЧГ=0") + " шт.");
			ТекущиеДанные.Количество = Доступно;
		КонецЕсли;
	КонецЕсли;
	ПересчитатьКорзину();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзКорзины(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаКорзина.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку в корзине.");
		Возврат;
	КонецЕсли;
	ЭтотОбъект["Корзина"].Удалить(ТекущиеДанные);
	ПересчитатьКорзину();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКорзину(Команда)
	
	ЭтотОбъект["Корзина"].Очистить();
	ПересчитатьКорзину();
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьЗаказ(Команда)
	
	Если ЭтотОбъект["Корзина"].Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Корзина пуста. Добавьте товары кнопкой «В корзину».");
		Возврат;
	КонецЕсли;
	
	Результат = ОформитьЗаказНаСервере();
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект["Корзина"].Очистить();
	ПересчитатьКорзину();
	ЗагрузитьТовары();
	ПоказатьОповещениеПользователя("Заказ оформлен", , Результат.Сообщение);
	
	// Чек открывается в отдельном окне
	Если Результат.ЧекТабДок <> Неопределено Тогда
		Результат.ЧекТабДок.ТолькоПросмотр = Истина;
		Результат.ЧекТабДок.Показать("Чек по заказу");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОформитьЗаказНаСервере()
	
	Результат = Новый Структура("Успех, Сообщение, ЧекТабДок", Ложь, "", Неопределено);
	
	Заказ = Документы.ЗаказТовара.СоздатьДокумент();
	Заказ.Дата = ТекущаяДатаСеанса();
	Заказ.Клиент = ПараметрыСеанса.ТекущийПользователь;
	Для Каждого Стр Из ЭтотОбъект["Корзина"] Цикл
		Новая = Заказ.Товары.Добавить();
		Новая.Товар = Стр.Товар;
		Новая.Размер = Стр.Размер;
		Новая.Количество = Стр.Количество;
		Новая.Цена = Стр.Цена;
		Новая.Сумма = Стр.Количество * Стр.Цена;
	КонецЦикла;
	
	Попытка
		Заказ.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Успех = Истина;
		Результат.Сообщение = "Заказ № " + СокрЛП(Заказ.Номер) + " на сумму "
			+ Формат(Заказ.СуммаДокумента, "ЧДЦ=2; ЧГ=") + " руб.";
		Результат.ЧекТабДок = Заказ.ПолучитьЧек();
	Исключение
		Результат.Сообщение = "Заказ не оформлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
