&НаСервере
Функция НовыйЭлемент(Имя, ТипЭлемента, Родитель)
	
	Если Родитель = Неопределено Тогда
		Возврат Элементы.Добавить(Имя, ТипЭлемента);
	КонецЕсли;
	Возврат Элементы.Добавить(Имя, ТипЭлемента, Родитель);
	
КонецФункции

&НаСервере
Процедура УстановитьШрифт(Элемент, Размер = 10, Жирный = Ложь)
	
	Шрифт = Неопределено;
	Попытка
		Шрифт = Новый Шрифт("Calibri", Размер, Жирный);
	Исключение
		Попытка
			Шрифт = Новый Шрифт(Неопределено, "Calibri", Размер, Жирный);
		Исключение
		КонецПопытки;
	КонецПопытки;
	Если Шрифт <> Неопределено Тогда
		Попытка
			Элемент.Шрифт = Шрифт;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НоваяГруппа(Имя, Родитель = Неопределено, Горизонтально = Ложь, Цвет = Неопределено)
	
	Группа = НовыйЭлемент(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ?(Горизонтально, ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Ложь;
	Если Цвет <> Неопределено Тогда
		Попытка
			Группа.ЦветФона = Цвет;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Группа;
	
КонецФункции

&НаСервере
Функция НоваяМетка(Имя, Родитель, Текст, Размер = 10, Жирный = Ложь)
	
	Метка = НовыйЭлемент(Имя, Тип("ДекорацияФормы"), Родитель);
	Метка.Вид = ВидДекорацииФормы.Надпись;
	Метка.Заголовок = Текст;
	УстановитьШрифт(Метка, Размер, Жирный);
	Возврат Метка;
	
КонецФункции

// ПоложениеЗаголовка: "Лево", "Верх" или "Нет"
&НаСервере
Функция НовоеПоле(Имя, Родитель, ПутьКДанным, Заголовок, Ширина = 0, Вид = Неопределено,
	ПоложениеЗаголовка = "Лево", ТолькоПросмотр = Ложь)
	
	Поле = НовыйЭлемент(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ?(Вид = Неопределено, ВидПоляФормы.ПолеВвода, Вид);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Заголовок = Заголовок;
	Если Ширина > 0 Тогда
		Поле.Ширина = Ширина;
		Попытка
			Поле.РастягиватьПоГоризонтали = Ложь;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если ТолькоПросмотр Тогда
		Поле.ТолькоПросмотр = Истина;
	КонецЕсли;
	Попытка
		Если ПоложениеЗаголовка = "Нет" Тогда
			Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ИначеЕсли ПоложениеЗаголовка = "Верх" Тогда
			Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		Иначе
			Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		КонецЕсли;
	Исключение
	КонецПопытки;
	УстановитьШрифт(Поле);
	Возврат Поле;
	
КонецФункции

&НаСервере
Функция НоваяКнопка(Имя, Родитель, Заголовок, Действие, Акцент = Ложь, Ширина = 0)
	
	Команда = Команды.Добавить(Имя);
	Команда.Действие = Действие;
	Команда.Заголовок = Заголовок;
	
	Кнопка = НовыйЭлемент(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = Имя;
	Если Ширина > 0 Тогда
		Кнопка.Ширина = Ширина;
	КонецЕсли;
	Если Акцент Тогда
		Попытка
			Кнопка.ЦветФона = Новый Цвет(112, 178, 175);   // #70B2AF
		Исключение
		КонецПопытки;
	КонецЕсли;
	УстановитьШрифт(Кнопка, 10, Акцент);
	Возврат Кнопка;
	
КонецФункции

&НаСервере
Функция НоваяТаблица(Имя, Родитель, ПутьКДанным, ТолькоПросмотр)
	
	Таблица = НовыйЭлемент(Имя, Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = ПутьКДанным;
	Таблица.ТолькоПросмотр = ТолькоПросмотр;
	Попытка
		Таблица.ИзменятьСоставСтрок = Ложь;
	Исключение
	КонецПопытки;
	Попытка
		Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Исключение
	КонецПопытки;
	УстановитьШрифт(Таблица);
	Возврат Таблица;
	
КонецФункции

&НаСервере
Процедура ПостроитьИнтерфейс(Авторизован)
	
	ЦветДоп = Новый Цвет(210, 246, 231);   // #D2F6E7
	
	// --- Шапка ---
	Шапка = НоваяГруппа("ГруппаШапка", Неопределено, Истина, ЦветДоп);
	НоваяМетка("МеткаЗаголовок", Шапка, "Каталог товаров", 16, Истина);
	Если Не Авторизован Тогда
		НоваяМетка("МеткаГость", Шапка, "   Режим просмотра. Чтобы заказать обувь, войдите в систему.");
	КонецЕсли;
	
	// --- Фильтры (только для авторизованных) ---
	Если Авторизован Тогда
		Фильтры = НоваяГруппа("ГруппаФильтры", Неопределено, Истина);
		ПолеПоиск = НовоеПоле("ПолеПоиск", Фильтры, "Поиск", "Поиск", 28);
		ПолеКатегория = НовоеПоле("ПолеКатегория", Фильтры, "ФильтрКатегория", "Категория", 22);
		ПолеПроизводство = НовоеПоле("ПолеПроизводство", Фильтры, "ФильтрПроизводство", "Производство", 26);
		ПолеСортировка = НовоеПоле("ПолеСортировка", Фильтры, "Сортировка", "Сортировка", 26);
		
		ПолеКатегория.РежимВыбораИзСписка = Истина;
		ПолеПроизводство.РежимВыбораИзСписка = Истина;
		ПолеСортировка.РежимВыбораИзСписка = Истина;
		ПолеКатегория.СписокВыбора.ЗагрузитьЗначения(ЗначенияКолонки("Категория"));
		ПолеПроизводство.СписокВыбора.ЗагрузитьЗначения(ЗначенияКолонки("Производство"));
		ПолеСортировка.СписокВыбора.Добавить("Наименование", "По наименованию (А-Я)");
		ПолеСортировка.СписокВыбора.Добавить("ЦенаВозр", "По цене (по возрастанию)");
		ПолеСортировка.СписокВыбора.Добавить("ЦенаУбыв", "По цене (по убыванию)");
		
		ПолеПоиск.УстановитьДействие("ПриИзменении", "ФильтрПриИзменении");
		ПолеКатегория.УстановитьДействие("ПриИзменении", "ФильтрПриИзменении");
		ПолеПроизводство.УстановитьДействие("ПриИзменении", "ФильтрПриИзменении");
		ПолеСортировка.УстановитьДействие("ПриИзменении", "ФильтрПриИзменении");
		НоваяКнопка("СброситьФильтры", Фильтры, "Сбросить", "СброситьФильтры");
	КонецЕсли;
	
	// --- Основная область: слева список, справа карточка ---
	Основная = НоваяГруппа("ГруппаОсновная", Неопределено, Истина);
	
	ТаблицаТовары = НоваяТаблица("ТаблицаТовары", Основная, "Товары", Истина);
	ТаблицаТовары.УстановитьДействие("ПриАктивизацииСтроки", "ТоварыПриАктивизацииСтроки");
	НовоеПоле("ТоварыНаименование", ТаблицаТовары, "Товары.Наименование", "Модель", 38, , , Истина);
	НовоеПоле("ТоварыКатегория", ТаблицаТовары, "Товары.Категория", "Категория", 14, , , Истина);
	НовоеПоле("ТоварыПодкатегория", ТаблицаТовары, "Товары.Подкатегория", "Подкатегория", 14, , , Истина);
	НовоеПоле("ТоварыПроизводство", ТаблицаТовары, "Товары.Производство", "Производство", 22, , , Истина);
	НовоеПоле("ТоварыЦена", ТаблицаТовары, "Товары.Цена", "Цена, руб.", 10, , , Истина);
	НовоеПоле("ТоварыОстаток", ТаблицаТовары, "Товары.Остаток", "Доступно, шт.", 10, , , Истина);
	
	Карточка = НоваяГруппа("ГруппаКарточка", Основная, Ложь, ЦветДоп);
	Попытка
		Карточка.Ширина = 55;
		Карточка.РастягиватьПоГоризонтали = Ложь;
	Исключение
	КонецПопытки;
	
	Картинка = НовоеПоле("ПолеИзображение", Карточка, "АдресИзображения", "Фото", 0, ВидПоляФормы.ПолеКартинки, "Нет", Истина);
	Попытка
		Картинка.РазмерКартинки = РазмерКартинки.Пропорционально;
		Картинка.Ширина = 30;
		Картинка.Высота = 10;
	Исключение
	КонецПопытки;
	НовоеПоле("ПолеНазвание", Карточка, "НазваниеТовара", "Модель", 0, ВидПоляФормы.ПолеНадписи, "Нет", Истина);
	НовоеПоле("ПолеЦена", Карточка, "ЦенаТовара", "Цена", 0, ВидПоляФормы.ПолеНадписи, "Лево", Истина);
	Описание = НовоеПоле("ПолеОписание", Карточка, "ОписаниеТовара", "Описание", 0, , "Верх", Истина);
	Состав = НовоеПоле("ПолеСостав", Карточка, "СоставТовара", "Состав", 0, , "Верх", Истина);
	Попытка
		Описание.МногострочныйРежим = Истина;
		Описание.Высота = 4;
		Состав.МногострочныйРежим = Истина;
		Состав.Высота = 2;
	Исключение
	КонецПопытки;
	
	// --- Выбор размера и добавление в корзину (только для авторизованных) ---
	Если Авторизован Тогда
		Заказ = НоваяГруппа("ГруппаЗаказ", Карточка, Истина);
		ПолеРазмер = НовоеПоле("ПолеРазмер", Заказ, "ВыбранныйРазмер", "Размер", 22);
		ПолеРазмер.РежимВыбораИзСписка = Истина;
		НовоеПоле("ПолеКоличество", Заказ, "ВыбранноеКоличество", "Количество", 6);
		НоваяКнопка("ДобавитьВКорзину", Заказ, "В корзину", "ДобавитьВКорзину", Истина);
		
		// --- Корзина ---
		КорзинаГруппа = НоваяГруппа("ГруппаКорзина", Неопределено, Ложь);
		НоваяМетка("МеткаКорзина", КорзинаГруппа, "Корзина", 14, Истина);
		ТаблицаКорзина = НоваяТаблица("ТаблицаКорзина", КорзинаГруппа, "Корзина", Ложь);
		НовоеПоле("КорзинаНазвание", ТаблицаКорзина, "Корзина.Название", "Товар", 38, , , Истина);
		НовоеПоле("КорзинаРазмер", ТаблицаКорзина, "Корзина.Размер", "Размер", 8, , , Истина);
		Количество = НовоеПоле("КорзинаКоличество", ТаблицаКорзина, "Корзина.Количество", "Количество", 10);
		НовоеПоле("КорзинаЦена", ТаблицаКорзина, "Корзина.Цена", "Цена", 12, , , Истина);
		НовоеПоле("КорзинаСумма", ТаблицаКорзина, "Корзина.Сумма", "Сумма", 12, , , Истина);
		Количество.УстановитьДействие("ПриИзменении", "КорзинаКоличествоПриИзменении");
		
		Низ = НоваяГруппа("ГруппаКорзинаНиз", КорзинаГруппа, Истина);
		НовоеПоле("ПолеИтого", Низ, "ИтогоКорзина", "Итого, руб.", 14, , , Истина);
		НоваяКнопка("УдалитьИзКорзины", Низ, "Удалить строку", "УдалитьИзКорзины");
		НоваяКнопка("ОчиститьКорзину", Низ, "Очистить корзину", "ОчиститьКорзину");
		НоваяКнопка("ОформитьЗаказ", Низ, "Оформить заказ", "ОформитьЗаказ", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗначенияКолонки(ИмяПоля)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Т." + ИмяПоля + " КАК Значение
	|ИЗ Справочник.Товары КАК Т
	|ГДЕ НЕ Т.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО Значение";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	
КонецФункции

// Подсветка цветом #ff8080 товаров, у которых суммарное доступное количество по всем размерам <= 3
&НаСервере
Процедура НастроитьПодсветку()
	
	УсловноеОформление.Элементы.Очистить();
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Для Каждого ИмяКолонки Из СтрРазделить("Наименование,Категория,Подкатегория,Производство,Цена,Остаток", ",") Цикл
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных("Товары" + ИмяКолонки);
		Поле.Использование = Истина;
	КонецЦикла;
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Остаток");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	Отбор.ПравоеЗначение = 3;
	Отбор.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 128, 128));
	
КонецПроцедуры

