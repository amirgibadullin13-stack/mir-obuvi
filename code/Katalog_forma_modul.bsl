// ГДЕ: Общие формы -> Каталог -> Модуль формы (форма пустая, ВСЁ строится кодом)
// Зависит только от: общий модуль Авторизация (ТекущаяРоль), документ ЗаказТовара (функция ПолучитьЧек),
// справочники Товары и Размеры, регистр накопления ОстаткиТоваров.
//
// Что умеет:
//   гость       - видит только список товаров и карточку модели (без фильтров, размера и корзины);
//   авторизован - поиск, фильтры, сортировка, выбор размера и количества, корзина, оформление заказа,
//                 после оформления открывается чек в отдельном окне.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Авторизован = (Авторизация.ТекущаяРоль() <> "Гость");
	ЭтотОбъект.Заголовок = "Каталог товаров";
	
	СоздатьРеквизиты();
	ЭтотОбъект["Сортировка"] = "Наименование";
	ЭтотОбъект["ВыбранноеКоличество"] = 1;
	
	ПостроитьИнтерфейс(Авторизован);
	НастроитьПодсветку();
	ЗагрузитьТовары();
	
КонецПроцедуры

// ---------------------------------------------------------------------------------------------
// РЕКВИЗИТЫ
// ---------------------------------------------------------------------------------------------

&НаСервере
Функция НовыйРеквизит(Имя, ТипСтрока, Длина = 0, Точность = 0, Путь = "")
	
	Если ТипСтрока = "Строка" Тогда
		Описание = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(Длина));
	ИначеЕсли ТипСтрока = "Число" Тогда
		Описание = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Длина, Точность));
	Иначе
		Описание = Новый ОписаниеТипов(ТипСтрока);
	КонецЕсли;
	Возврат Новый РеквизитФормы(Имя, Описание, Путь);
	
КонецФункции

&НаСервере
Процедура СоздатьРеквизиты()
	
	Описания = Новый Массив;
	Описания.Добавить(НовыйРеквизит("Товары", "ТаблицаЗначений"));
	Описания.Добавить(НовыйРеквизит("Корзина", "ТаблицаЗначений"));
	Описания.Добавить(НовыйРеквизит("Поиск", "Строка", 100));
	Описания.Добавить(НовыйРеквизит("ФильтрКатегория", "Строка", 50));
	Описания.Добавить(НовыйРеквизит("ФильтрПроизводство", "Строка", 100));
	Описания.Добавить(НовыйРеквизит("Сортировка", "Строка", 20));
	Описания.Добавить(НовыйРеквизит("ВыбранныйРазмер", "СправочникСсылка.Размеры"));
	Описания.Добавить(НовыйРеквизит("ВыбранноеКоличество", "Число", 3, 0));
	Описания.Добавить(НовыйРеквизит("АдресИзображения", "Строка", 200));
	Описания.Добавить(НовыйРеквизит("НазваниеТовара", "Строка", 200));
	Описания.Добавить(НовыйРеквизит("ЦенаТовара", "Строка", 50));
	Описания.Добавить(НовыйРеквизит("ОписаниеТовара", "Строка", 0));
	Описания.Добавить(НовыйРеквизит("СоставТовара", "Строка", 0));
	Описания.Добавить(НовыйРеквизит("ИтогоКорзина", "Число", 12, 2));
	ИзменитьРеквизиты(Описания);
	
	Колонки = Новый Массив;
	Колонки.Добавить(НовыйРеквизит("Ссылка", "СправочникСсылка.Товары", 0, 0, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Наименование", "Строка", 150, 0, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Категория", "Строка", 50, 0, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Подкатегория", "Строка", 50, 0, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Производство", "Строка", 100, 0, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Цена", "Число", 10, 2, "Товары"));
	Колонки.Добавить(НовыйРеквизит("Остаток", "Число", 10, 0, "Товары"));
	
	Колонки.Добавить(НовыйРеквизит("Товар", "СправочникСсылка.Товары", 0, 0, "Корзина"));
	Колонки.Добавить(НовыйРеквизит("Название", "Строка", 150, 0, "Корзина"));
	Колонки.Добавить(НовыйРеквизит("Размер", "СправочникСсылка.Размеры", 0, 0, "Корзина"));
	Колонки.Добавить(НовыйРеквизит("Количество", "Число", 6, 0, "Корзина"));
	Колонки.Добавить(НовыйРеквизит("Цена", "Число", 10, 2, "Корзина"));
	Колонки.Добавить(НовыйРеквизит("Сумма", "Число", 12, 2, "Корзина"));
	ИзменитьРеквизиты(Колонки);
	
КонецПроцедуры

